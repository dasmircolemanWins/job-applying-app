# ApplyPilot environment (optional). Values saved in Settings take precedence over these.

# Anthropic API key. If absent here AND not saved in Settings, agents run in deterministic mock mode.
ANTHROPIC_API_KEY=

# Server port (default 4310). The Vite dev server proxies /api here.
PORT=4310

# Set to "production" to serve the built web app (web/dist) from the server.
NODE_ENV=development

# Hosted account deletion only. Server-side secret; never use a VITE_ prefix
# or expose this value to the browser/mobile app.
SUPABASE_SERVICE_ROLE_KEY=
